# Shared network storage. Team1..22 are required; Team23..26 are optional reserves.
TA_MNT_ROOT=/mnt
TA_ADMIN_ROOT=/mnt/Admin-Storage_7ed0d
TA_BACKUP_ROOT=/mnt/Admin-Storage_7ed0d/submission-backups
TA_EXPECTED_TEAM_COUNT=22
TA_MAX_TEAM_NUMBER=26
TA_MAX_SUBMISSIONS_PER_TEAM=30
TA_MAX_PENDING_CAPTURES=6

# Conservative intake: initial observation + three unchanged 20-second checks,
# then one staged copy and a second full source hash at least 20 seconds later.
TA_POLL_SECONDS=20
TA_STABLE_CONFIRMATIONS=3
TA_POST_COPY_SECONDS=20
TA_MIN_CHECKPOINT_BYTES=300000000
TA_MAX_CHECKPOINT_BYTES=536870912
TA_RECURSIVE_SCAN=0

# SQLite remains on local disk. A consistent snapshot is copied to Admin storage.
TA_STATE_ROOT=$HOME/.local/state/hackathon-ta-grader
TA_DATABASE_PATH=$HOME/.local/state/hackathon-ta-grader/grading.sqlite3

# Private grading assets are installed from the pinned private HF dataset.
TA_GRADING_ROOT=$HOME/private-grading/assets
# The same Python that starts ops/run.sh is used by default. Set this only when
# torch 2.8.0 + torchvision 0.23.0 + CUDA 12.8 live in another interpreter.
# TA_GRADER_PYTHON=/absolute/path/to/python3
TA_HF_REPO=cau-ai-hackathon/imagenet-grading
TA_HF_REVISION=5d8f84f903f177ebab5b43188a792d2436d50230
TA_HF_FILENAME=grading_docker.tar
TA_HF_ARCHIVE_BYTES=1075558400
TA_HF_ARCHIVE_SHA256=0caa77605652dd213ea967b944e9168e3a5c3f5ebd4847af168fc7f849da55af

# Each completed result is also delivered as {"team_id": N, "score": value}.
TA_SCORE_POST_URL=https://api.minds.ai.kr/submit
TA_SCORE_POST_TIMEOUT_SECONDS=10
TA_SCORE_POST_RETRY_SECONDS=60

# Bootstrap normally asks once and Hugging Face stores the credential in its
# standard local token store. An owner-only custom file remains supported:
# TA_HF_TOKEN_FILE=$HOME/.config/huggingface/token

# GPU 0 is rejected by configuration and remains available for manual work.
TA_GPU_IDS=1,2,3
TA_WORKER_POLL_SECONDS=2
TA_LOG_LEVEL=INFO
